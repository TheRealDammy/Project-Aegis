            </ui:VisualElement>
            <ui:VisualElement name="SpeedControls" class="speed-controls">
                <ui:Button name="PauseButton" text="⏸" class="speed-btn" />
                <ui:Button name="Speed1Button" text="▶" class="speed-btn" />
                <ui:Button name="Speed2Button" text="▶▶" class="speed-btn" />
                <ui:Button name="Speed4Button" text="▶▶▶" class="speed-btn" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="MainArea" class="main-area">
            <ui:VisualElement name="SideNav" class="side-nav">
                <ui:Button name="NavOverview" text="OVR" class="nav-btn" />
                <ui:Button name="NavResearch" text="RES" class="nav-btn" />
                <ui:Button name="NavEmployees" text="EMP" class="nav-btn" />
                <ui:Button name="NavContracts" text="CON" class="nav-btn" />
                <ui:Button name="NavMarket" text="MKT" class="nav-btn" />
                <ui:Button name="NavWorld" text="WLD" class="nav-btn" />
            </ui:VisualElement>
            <ui:VisualElement name="ContentArea" class="content-area">
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
