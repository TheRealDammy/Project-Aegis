<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/USS/AegisCommon.uss?fileID=7433441132597879392&amp;guid=66d75c3794445e54591b4006bef3a0a5&amp;type=3#AegisCommon" />
    <ui:VisualElement name="Root" class="root-container" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; flex-direction: column;">
        <ui:VisualElement name="TopBar" class="top-bar">
            <ui:Label name="CompanyNameLabel" text="AEGIS SYSTEMS" class="company-name" />
