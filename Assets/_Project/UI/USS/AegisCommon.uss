/* =========================================================
   AegisCommon.uss
   Design system for Project Aegis — UI Toolkit implementation
   Colour source of truth: 04_Art_Direction.md
   Layout source of truth: 04_Art_Direction.md §Layout Principles
   ========================================================= */


/* ——— Root Container ———————————————————————————————————————
   Full-screen flex column. Everything lives inside this.    */

.root-container {
    background-color: #111923;
}


/* ——— Top Bar ——————————————————————————————————————————————
   48px fixed height (6 × 8px grid).
   Aegis Blue fill, Wire Grey bottom border.                 */

.top-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    height: 48px;
    background-color: #1E3A5F;
    border-bottom-width: 1px;
    border-bottom-color: #2E4060;
    padding-left: 16px;
    padding-right: 16px;
}

.company-name {
    color: #E8EDF3;
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.top-bar-stats {
    flex-direction: row;
    align-items: center;
}

.stat-value {
    color: #E8EDF3;
    font-size: 14px;
    margin-left: 24px;
    margin-right: 24px;
}

/* Speed control buttons — secondary style, 32×32 (4×8px grid) */
.speed-controls {
    flex-direction: row;
    align-items: center;
}

.speed-btn {
    width: 32px;
    height: 32px;
    margin-left: 4px;
    background-color: #1A2535;
    border-width: 1px;
    border-color: #2E4060;
    border-radius: 0;
    color: #8A9BB5;
    font-size: 12px;
    -unity-text-align: middle-center;
}

.speed-btn:hover {
    background-color: #22304A;
    color: #E8EDF3;
    border-color: #8A9BB5;
}

.speed-btn:active {
    background-color: #0A8A8A;
    border-color: #0A8A8A;
    color: #E8EDF3;
}

/* Active speed button — Signal Teal fill (applied from C# to current speed) */
.speed-btn--active {
    background-color: #0A8A8A;
    border-color: #0A8A8A;
    color: #E8EDF3;
}


/* ——— Main Area ————————————————————————————————————————————
   Flex row — side nav + content area side by side.
   flex-grow: 1 fills all vertical space below the top bar.  */

.main-area {
    flex-direction: row;
    flex-grow: 1;
    align-items: stretch;  /* REQUIRED — Unity defaults to flex-start, not stretch */
}

/* ——— Side Nav —————————————————————————————————————————————
   200px fixed width (art direction spec).
   Panel Ink background, Wire Grey right border.             */

.side-nav {
    flex-direction: column;
    flex-shrink: 0;
    align-self: stretch;   /* Belt-and-suspenders — ensures height fills main-area */
    width: 200px;
    background-color: #1A2535;
    border-right-width: 1px;
    border-right-color: #2E4060;
    padding-top: 8px;
}

/* Nav tab buttons — 48px tall (6×8px), full width, left-aligned text */
.nav-btn {
    height: 48px;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    padding-left: 16px;
    padding-right: 16px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    /* Left accent border: transparent by default, Signal Teal when active */
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    color: #8A9BB5;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    letter-spacing: 2px;
}

.nav-btn:hover {
    background-color: #22304A;
    color: #E8EDF3;
}

/* Active nav state — toggled from C# via AddToClassList / RemoveFromClassList */
.nav-btn--active {
    background-color: #22304A;
    color: #E8EDF3;
    border-left-color: #0A8A8A;
}


/* ——— Content Area —————————————————————————————————————————
   Fills remaining width. Deep Slate background.
   16px internal padding (art direction spec).               */


.content-area {
    flex-grow: 1;
    align-self: stretch;   /* Same — fill full height of main-area */
    background-color: #111923;
    padding: 16px;
}


/* M0 placeholder label — replaced by real panels in M1+ */
.panel-placeholder-label {
    width: 100%;
    height: 100%;
    color: #2E4060;
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;

}

/* ══════════════════════════════════════════════════════════
   RESEARCH PANEL
   Column layout: 4 branches side by side.
   Node cards show state via modifier class — no inline styles.
   ══════════════════════════════════════════════════════════ */

.research-panel {
    flex-direction: row;
    flex-grow: 1;
    padding: 16px;
    align-items: flex-start;
}

/* One column per branch */
.branch-column {
    flex-direction: column;
    flex-grow: 1;
    margin-right: 8px;
    align-items: stretch;
}

.branch-header {
    color: #8A9BB5;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    padding-bottom: 8px;
    padding-left: 4px;
    border-bottom-width: 1px;
    border-bottom-color: #2E4060;
    margin-bottom: 8px;
}

/* ——— Node Card ——————————————————————————————————————————— */

.node-card {
    flex-direction: column;
    padding: 12px;
    margin-bottom: 6px;
    background-color: #1A2535;
    border-width: 1px;
    border-color: #2E4060;
    border-radius: 0;
    border-left-width: 3px;
    border-left-color: #2E4060;
}

/* State modifier classes — toggled from C# */

.node-card--locked {
    background-color: #111923;
    border-left-color: #2E4060;
    opacity: 0.6;
}

.node-card--available {
    background-color: #1A2535;
    border-left-color: #8A9BB5;
}

.node-card--available:hover {
    background-color: #22304A;
    border-left-color: #E8EDF3;
}

.node-card--in-progress {
    background-color: #1A2535;
    border-left-color: #0A8A8A;
}

.node-card--complete {
    background-color: #1A2535;
    border-left-color: #2DB87A;
    opacity: 0.8;
}

/* Node content */

.node-name {
    color: #E8EDF3;
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.node-card--locked .node-name {
    color: #8A9BB5;
}

.node-status {
    color: #8A9BB5;
    font-size: 11px;
    margin-bottom: 6px;
}

.node-card--in-progress .node-status {
    color: #0A8A8A;
}

.node-card--complete .node-status {
    color: #2DB87A;
}

/* Progress bar — visible only when InProgress */

.node-progress-bar {
    height: 6px;
    background-color: #2E4060;
    margin-bottom: 6px;
}

.node-progress-fill {
    height: 6px;
    background-color: #0A8A8A;
    /* Width set inline from C# as a percentage */
}

/* Assign button — secondary style, compact */

.node-assign-btn {
    height: 24px;
    margin-top: 4px;
    padding-left: 8px;
    padding-right: 8px;
    background-color: rgba(0,0,0,0);
    border-width: 1px;
    border-color: #8A9BB5;
    border-radius: 0;
    color: #8A9BB5;
    font-size: 11px;
    -unity-text-align: middle-center;
}

.node-assign-btn:hover {
    background-color: #22304A;
    border-color: #E8EDF3;
    color: #E8EDF3;
}

/* ══════════════════════════════════════════════════════════
   CONTRACT PANEL
   Two sections: Available offers, Active contracts.
   ══════════════════════════════════════════════════════════ */

.contract-panel {
    flex-direction: column;
    flex-grow: 1;
    padding: 16px;
    overflow: hidden;
}

.contract-section-header {
    color: #8A9BB5;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: #2E4060;
    margin-bottom: 8px;
    margin-top: 16px;
}

/* ——— Contract Card ——————————————————————————————————————— */

.contract-card {
    flex-direction: row;
    align-items: center;
    padding: 12px;
    margin-bottom: 6px;
    background-color: #1A2535;
    border-width: 1px;
    border-color: #2E4060;
    border-left-width: 3px;
    border-left-color: #2E4060;
    border-radius: 0;
}

.contract-card--available {
    border-left-color: #8A9BB5;
}

.contract-card--active {
    border-left-color: #0A8A8A;
}

.contract-card--success {
    border-left-color: #2DB87A;
}

.contract-card--failed {
    border-left-color: #C0392B;
}

/* Card info column (flex-grow fills available width) */
.contract-card-info {
    flex-direction: column;
    flex-grow: 1;
}

.contract-card-title {
    color: #E8EDF3;
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.contract-card-detail {
    color: #8A9BB5;
    font-size: 11px;
}

.contract-card-risk {
    color: #E8A020; /* Amber Alert — risk is a warning-category value */
    font-size: 11px;
    margin-top: 2px;
}

.contract-card-risk--low {
    color: #2DB87A;
}

.contract-card-risk--high {
    color: #C0392B;
}

/* Accept button — primary action, right-aligned */
.contract-accept-btn {
    flex-shrink: 0;
    width: 100px;
    height: 32px;
    margin-left: 16px;
    background-color: #0A8A8A;
    border-width: 0;
    border-radius: 0;
    color: #E8EDF3;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
}

.contract-accept-btn:hover {
    background-color: #0BAAAA;
}

.contract-accept-btn:disabled {
    background-color: #2E4060;
    color: #8A9BB5;
}

/* ——— Reputation label in top bar ———————————————————————— */
.rep-label {
    color: #0A8A8A; /* Signal Teal — reputation is positive-state colour */
}