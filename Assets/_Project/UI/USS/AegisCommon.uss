/* =========================================================
   AegisCommon.uss
   Design system for Project Aegis — UI Toolkit implementation
   Colour source of truth: 04_Art_Direction.md
   Layout source of truth: 04_Art_Direction.md §Layout Principles
   ========================================================= */


/* ——— Root Container ———————————————————————————————————————
   Full-screen flex column. Everything lives inside this.    */

.root-container {
    background-color: #111923;
}


/* ——— Top Bar ——————————————————————————————————————————————
   48px fixed height (6 × 8px grid).
   Aegis Blue fill, Wire Grey bottom border.                 */

.top-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    height: 48px;
    background-color: #1E3A5F;
    border-bottom-width: 1px;
    border-bottom-color: #2E4060;
    padding-left: 16px;
    padding-right: 16px;
}

.company-name {
    color: #E8EDF3;
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.top-bar-stats {
    flex-direction: row;
    align-items: center;
}

.stat-value {
    color: #E8EDF3;
    font-size: 14px;
    margin-left: 24px;
    margin-right: 24px;
}

/* Speed control buttons — secondary style, 32×32 (4×8px grid) */
.speed-controls {
    flex-direction: row;
    align-items: center;
}

.speed-btn {
    width: 32px;
    height: 32px;
    margin-left: 4px;
    background-color: #1A2535;
    border-width: 1px;
    border-color: #2E4060;
    border-radius: 0;
    color: #8A9BB5;
    font-size: 12px;
    -unity-text-align: middle-center;
}

.speed-btn:hover {
    background-color: #22304A;
    color: #E8EDF3;
    border-color: #8A9BB5;
}

.speed-btn:active {
    background-color: #0A8A8A;
    border-color: #0A8A8A;
    color: #E8EDF3;
}

/* Active speed button — Signal Teal fill (applied from C# to current speed) */
.speed-btn--active {
    background-color: #0A8A8A;
    border-color: #0A8A8A;
    color: #E8EDF3;
}


/* ——— Main Area ————————————————————————————————————————————
   Flex row — side nav + content area side by side.
   flex-grow: 1 fills all vertical space below the top bar.  */

.main-area {
    flex-direction: row;
    flex-grow: 1;
    align-items: stretch;  /* REQUIRED — Unity defaults to flex-start, not stretch */
}

/* ——— Side Nav —————————————————————————————————————————————
   200px fixed width (art direction spec).
   Panel Ink background, Wire Grey right border.             */

.side-nav {
    flex-direction: column;
    flex-shrink: 0;
    align-self: stretch;   /* Belt-and-suspenders — ensures height fills main-area */
    width: 200px;
    background-color: #1A2535;
    border-right-width: 1px;
    border-right-color: #2E4060;
    padding-top: 8px;
}

/* Nav tab buttons — 48px tall (6×8px), full width, left-aligned text */
.nav-btn {
    height: 48px;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    padding-left: 16px;
    padding-right: 16px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    /* Left accent border: transparent by default, Signal Teal when active */
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    color: #8A9BB5;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    letter-spacing: 2px;
}

.nav-btn:hover {
    background-color: #22304A;
    color: #E8EDF3;
}

/* Active nav state — toggled from C# via AddToClassList / RemoveFromClassList */
.nav-btn--active {
    background-color: #22304A;
    color: #E8EDF3;
    border-left-color: #0A8A8A;
}


/* ——— Content Area —————————————————————————————————————————
   Fills remaining width. Deep Slate background.
   16px internal padding (art direction spec).               */


.content-area {
    flex-grow: 1;
    align-self: stretch;   /* Same — fill full height of main-area */
    background-color: #111923;
    padding: 16px;
}


/* M0 placeholder label — replaced by real panels in M1+ */
.panel-placeholder-label {
    width: 100%;
    height: 100%;
    color: #2E4060;
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;

}

/* ══════════════════════════════════════════════════════════
   RESEARCH PANEL
   Column layout: 4 branches side by side.
   Node cards show state via modifier class — no inline styles.
   ══════════════════════════════════════════════════════════ */

.research-panel {
    flex-direction: row;
    flex-grow: 1;
    padding: 16px;
    align-items: flex-start;
}

/* One column per branch */
.branch-column {
    flex-direction: column;
    flex-grow: 1;
    margin-right: 8px;
    align-items: stretch;
}

.branch-header {
    color: #8A9BB5;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    padding-bottom: 8px;
    padding-left: 4px;
    border-bottom-width: 1px;
    border-bottom-color: #2E4060;
    margin-bottom: 8px;
}

/* ——— Node Card ——————————————————————————————————————————— */

.node-card {
    flex-direction: column;
    padding: 12px;
    margin-bottom: 6px;
    background-color: #1A2535;
    border-width: 1px;
    border-color: #2E4060;
    border-radius: 0;
    border-left-width: 3px;
    border-left-color: #2E4060;
}

/* State modifier classes — toggled from C# */

.node-card--locked {
    background-color: #111923;
    border-left-color: #2E4060;
    opacity: 0.6;
}

.node-card--available {
    background-color: #1A2535;
    border-left-color: #8A9BB5;
}

.node-card--available:hover {
    background-color: #22304A;
    border-left-color: #E8EDF3;
}

.node-card--in-progress {
    background-color: #1A2535;
    border-left-color: #0A8A8A;
}

.node-card--complete {
    background-color: #1A2535;
    border-left-color: #2DB87A;
    opacity: 0.8;
}

/* Node content */

.node-name {
    color: #E8EDF3;
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.node-card--locked .node-name {
    color: #8A9BB5;
}

.node-status {
    color: #8A9BB5;
    font-size: 11px;
    margin-bottom: 6px;
}

.node-card--in-progress .node-status {
    color: #0A8A8A;
}

.node-card--complete .node-status {
    color: #2DB87A;
}

/* Progress bar — visible only when InProgress */

.node-progress-bar {
    height: 6px;
    background-color: #2E4060;
    margin-bottom: 6px;
}

.node-progress-fill {
    height: 6px;
    background-color: #0A8A8A;
    /* Width set inline from C# as a percentage */
}

/* Assign button — secondary style, compact */

.node-assign-btn {
    height: 24px;
    margin-top: 4px;
    padding-left: 8px;
    padding-right: 8px;
    background-color: rgba(0,0,0,0);
    border-width: 1px;
    border-color: #8A9BB5;
    border-radius: 0;
    color: #8A9BB5;
    font-size: 11px;
    -unity-text-align: middle-center;
}

.node-assign-btn:hover {
    background-color: #22304A;
    border-color: #E8EDF3;
    color: #E8EDF3;
}

/* ══════════════════════════════════════════════════════════
   CONTRACT PANEL
   Two sections: Available offers, Active contracts.
   ══════════════════════════════════════════════════════════ */

.contract-panel {
    flex-direction: column;
    flex-grow: 1;
    padding: 16px;
    overflow: hidden;
}

.contract-section-header {
    color: #8A9BB5;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: #2E4060;
    margin-bottom: 8px;
    margin-top: 16px;
}

/* ——— Contract Card ——————————————————————————————————————— */

.contract-card {
    flex-direction: row;
    align-items: center;
    padding: 12px;
    margin-bottom: 6px;
    background-color: #1A2535;
    border-width: 1px;
    border-color: #2E4060;
    border-left-width: 3px;
    border-left-color: #2E4060;
    border-radius: 0;
}

.contract-card--available {
    border-left-color: #8A9BB5;
}

.contract-card--active {
    border-left-color: #0A8A8A;
}

.contract-card--success {
    border-left-color: #2DB87A;
}

.contract-card--failed {
    border-left-color: #C0392B;
}

/* Card info column (flex-grow fills available width) */
.contract-card-info {
    flex-direction: column;
    flex-grow: 1;
}

.contract-card-title {
    color: #E8EDF3;
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.contract-card-detail {
    color: #8A9BB5;
    font-size: 11px;
}

.contract-card-risk {
    color: #E8A020; /* Amber Alert — risk is a warning-category value */
    font-size: 11px;
    margin-top: 2px;
}

.contract-card-risk--low {
    color: #2DB87A;
}

.contract-card-risk--high {
    color: #C0392B;
}

/* Accept button — primary action, right-aligned */
.contract-accept-btn {
    flex-shrink: 0;
    width: 100px;
    height: 32px;
    margin-left: 16px;
    background-color: #0A8A8A;
    border-width: 0;
    border-radius: 0;
    color: #E8EDF3;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
}

.contract-accept-btn:hover {
    background-color: #0BAAAA;
}

.contract-accept-btn:disabled {
    background-color: #2E4060;
    color: #8A9BB5;
}

/* ——— Reputation label in top bar ———————————————————————— */
.rep-label {
    color: #0A8A8A; /* Signal Teal — reputation is positive-state colour */
}

/* ══════════════════════════════════════════════════════════
   EMPLOYEES PANEL
   Two sections: Hiring Pool (candidates) and Roster (staff).
   ══════════════════════════════════════════════════════════ */

.employees-panel {
    flex-direction: row;
    flex-grow: 1;
}

/* Left column: hiring pool. Right column: roster. */
.emp-column {
    flex-direction: column;
    flex-grow: 1;
    padding: 16px;
    overflow: hidden;
}

.emp-column--left {
    border-right-width: 1px;
    border-right-color: #2E4060;
}

.emp-section-header {
    color: #8A9BB5;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: #2E4060;
    margin-bottom: 8px;
}

/* ——— Candidate / Employee Card —————————————————————————— */

.emp-card {
    flex-direction: column;
    padding: 10px 12px;
    margin-bottom: 6px;
    background-color: #1A2535;
    border-width: 1px;
    border-color: #2E4060;
    border-left-width: 3px;
    border-left-color: #2E4060;
    border-radius: 0;
}

.emp-card--candidate {
    border-left-color: #8A9BB5;
}

.emp-card--expiring {
    /* Candidate with 1 week remaining */
    border-left-color: #E8A020;
}

.emp-card--rostered {
    border-left-color: #2DB87A;
}

.emp-card--assigned {
    border-left-color: #0A8A8A;
}

.emp-card-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.emp-card-name {
    color: #E8EDF3;
    font-size: 12px;
    -unity-font-style: bold;
    flex-grow: 1;
}

.emp-card-role {
    color: #8A9BB5;
    font-size: 11px;
}

.emp-card-detail {
    color: #8A9BB5;
    font-size: 11px;
    margin-top: 2px;
}

.emp-card-expiry {
    color: #E8A020;
    font-size: 11px;
    margin-top: 2px;
}

.emp-card-expiry--urgent {
    color: #C0392B;
}

.emp-hire-btn {
    margin-top: 6px;
    height: 24px;
    background-color: #0A8A8A;
    border-width: 0;
    border-radius: 0;
    color: #E8EDF3;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.emp-hire-btn:hover { 
    background-color: #0BAAAA; 
}

/* ══════════════════════════════════════════════════════════
   EMPLOYEES PANEL — TABLE LAYOUT
   Art direction: alternating rows, monospace numbers,
   uppercase label-size column headers.
   ══════════════════════════════════════════════════════════ */

.emp-panel {
    flex-direction: column;
    flex-grow: 1;
    padding: 16px;
}

/* ——— Section separator ——————————————————————————————————— */

.emp-section-label {
    color: #8A9BB5;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    padding-bottom: 8px;
    padding-top: 16px;
    border-bottom-width: 1px;
    border-bottom-color: #2E4060;
    margin-bottom: 0;
}

/* ——— Table header row ———————————————————————————————————— */

.table-header-row {
    flex-direction: row;
    align-items: center;
    background-color: #1A2535;
    border-bottom-width: 1px;
    border-bottom-color: #2E4060;
    padding-left: 8px;
    padding-right: 8px;
    height: 32px;
}

.table-header-cell {
    color: #8A9BB5;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

/* ——— Table data rows ————————————————————————————————————— */

.table-row--even { background-color: #1A2535; } /* Panel Ink */
.table-row--odd  { background-color: #22304A; } /* Soft Slate */

.table-row {
    flex-direction: row;
    align-items: center;
    height: 40px;
    padding-left: 8px;
    padding-right: 8px;
    border-bottom-width: 1px;
    border-bottom-color: #2E4060;
}

.table-row:hover { background-color: #22304A; }

/* Cell sizing — EMP panel column widths */
.emp-col-name    { flex-grow: 2; min-width: 120px; }
.emp-col-role    { flex-grow: 1; min-width: 80px;  }
.emp-col-stat    { flex-grow: 1; min-width: 80px;  }
.emp-col-traits  { flex-grow: 1; min-width: 80px;  }
.emp-col-salary  { flex-grow: 1; min-width: 90px;  }
.emp-col-expiry  { flex-grow: 1; min-width: 70px;  }
.emp-col-action  { flex-shrink: 0; width: 120px;   }

/* Text styles within cells */
.cell-text-primary {
    color: #E8EDF3;
    font-size: 14px;
}

.cell-text-secondary {
    color: #8A9BB5;
    font-size: 12px;
}

/* Monospace for all numeric values per art direction */
.cell-text-data {
    color: #E8EDF3;
    font-size: 14px;
    /* JetBrains Mono — requires font asset import (data task, not code task).
       Font family assignment pending asset setup in M5. */
}

.cell-text-data--dim {
    color: #8A9BB5;
    font-size: 14px;
}

.cell-text-warning {
    color: #E8A020;
    font-size: 12px;
}

.cell-text-success {
    color: #2DB87A;
    font-size: 12px;
}

/* Numbers right-aligned per art direction */
.align-right { -unity-text-align: middle-right; }
.align-left  { -unity-text-align: middle-left;  }

/* ——— EMP hire button — compact secondary style ————————— */

.emp-hire-btn {
    height: 28px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: #0A8A8A;
    border-width: 0;
    border-radius: 0;
    color: #E8EDF3;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.emp-hire-btn:hover    { background-color: #0BAAAA; }
.emp-hire-btn:disabled { background-color: #2E4060; color: #8A9BB5; }

/* ——— Assignment dropdown ————————————————————————————————— */

.emp-assign-dropdown {
    height: 28px;
    min-width: 160px;
    background-color: #1A2535;
    border-width: 1px;
    border-color: #2E4060;
    border-radius: 0;
    color: #E8EDF3;
    font-size: 11px;
    margin-right: 4px;
    flex-grow: 1;
}

.emp-assign-btn {
    height: 28px;
    padding-left: 8px;
    padding-right: 8px;
    background-color: rgba(0,0,0,0);
    border-width: 1px;
    border-color: #8A9BB5;
    border-radius: 0;
    color: #8A9BB5;
    font-size: 11px;
}

.emp-assign-btn:hover { background-color: #22304A; color: #E8EDF3; border-color: #E8EDF3; }

/* ══════════════════════════════════════════════════════════
   NOTIFICATION BANNERS
   Positioned absolutely in top-right, above all panels.
   ══════════════════════════════════════════════════════════ */

.notification-container {
    position: absolute;
    right: 16px;
    top: 64px;
    width: 320px;
    flex-direction: column;
}

.notification-banner {
    width: 320px;
    padding: 12px 16px;
    margin-bottom: 8px;
    background-color: #1A2535;
    border-width: 1px;
    border-color: #2E4060;
    border-left-width: 4px;
    border-left-color: #8A9BB5;
}

.notification-banner--success { border-left-color: #2DB87A; }
.notification-banner--warning { border-left-color: #E8A020; }
.notification-banner--failure { border-left-color: #C0392B; }

.notification-title {
    color: #E8EDF3;
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.notification-body {
    color: #8A9BB5;
    font-size: 11px;
}
/* ——— M5 NODE GRAPH: Connector lines ——————————————————————
   A thin vertical line between each sequential node pair.
   Styled by the state of the CHILD node it points toward.  */

.node-connector {
    width: 2px;
    height: 20px;          /* 20px gap between node cards */
    margin-left: 16px;     /* Align with node card's left accent border */
    background-color: #2E4060; /* Wire Grey — locked state */
}

/* Connector is Signal Teal when the child node is reachable */
.node-connector--active {
    background-color: #0A8A8A;
}

/* ——— M5 NODE CARD: Enhanced state treatment —————————————— */

/* Complete nodes fade slightly — they're done, not the focus */
.node-card--complete {
    opacity: 0.75;
}

/* Available nodes get a subtle left-border pulse via CSS transition */
.node-card--available {
    transition-property: border-left-color;
    transition-duration: 600ms;
    transition-timing-function: ease-in-out;
}

/* Progress fill animation for InProgress nodes */
.node-progress-fill {
    transition-property: width;
    transition-duration: 400ms;
    transition-timing-function: ease-out;
}

/* ══════════════════════════════════════════════════════════
   NOTIFICATION ANIMATION — USS TRANSITION (not DOTween)
   DOTween scoped to non-UITK per DD-08. USS handles this.
   ══════════════════════════════════════════════════════════ */

.notification-container {
    position: absolute;
    right: 16px;
    top: 64px;
    width: 320px;
    flex-direction: column;
}

.notification-banner {
    width: 320px;
    padding: 12px 16px;
    margin-bottom: 8px;
    background-color: #1A2535;
    border-width: 1px;
    border-color: #2E4060;
    border-left-width: 4px;
    border-left-color: #8A9BB5;

    /* Start translated right (off-screen) — transition slides it in */
    translate: 340px 0;
    transition-property: translate;
    transition-duration: 200ms;
    transition-timing-function: ease-out;
    opacity: 0;
    transition: translate 200ms ease-out, opacity 200ms ease-out;
}

/* Applied one frame after insertion — triggers the transition */
.notification-banner--visible {
    translate: 0 0;
    opacity: 1;
}

.notification-banner--success { border-left-color: #2DB87A; }
.notification-banner--warning { border-left-color: #E8A020; }
.notification-banner--failure { border-left-color: #C0392B; }

.notification-title {
    color: #E8EDF3;
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.notification-body {
    color: #8A9BB5;
    font-size: 11px;
}

/* ══════════════════════════════════════════════════════════
   MODAL OVERLAY — shared base for Settings and Pause panels
   Full-screen backdrop blocks pointer events to panels below.
   ══════════════════════════════════════════════════════════ */

.modal-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    /* Semi-transparent Deep Slate — panels visible but dimmed behind */
    background-color: rgba(17, 25, 35, 0.85);
    align-items: center;
    justify-content: center;
}

.modal-panel {
    flex-direction: column;
    background-color: #1A2535;
    border-width: 1px;
    border-color: #2E4060;
    border-radius: 0;
    padding: 0;
}

.modal-header {
    flex-direction: row;
    align-items: center;
    background-color: #1E3A5F;
    border-bottom-width: 1px;
    border-bottom-color: #2E4060;
    padding-left: 24px;
    padding-right: 16px;
    height: 48px;
}

.modal-title {
    color: #E8EDF3;
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    flex-grow: 1;
}

.modal-close-btn {
    width: 32px;
    height: 32px;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    color: #8A9BB5;
    font-size: 16px;
    -unity-text-align: middle-center;
}

.modal-close-btn:hover { color: #E8EDF3; background-color: #C0392B; }

/* ——— Settings panel ——————————————————————————————————————— */

.settings-panel {
    width: 640px;
}

.settings-tab-bar {
    flex-direction: row;
    border-bottom-width: 1px;
    border-bottom-color: #2E4060;
    background-color: #111923;
}

.settings-tab {
    height: 40px;
    padding-left: 24px;
    padding-right: 24px;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0,0,0,0);
    border-radius: 0;
    color: #8A9BB5;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.settings-tab:hover  { color: #E8EDF3; }
.settings-tab--active {
    color: #E8EDF3;
    border-bottom-color: #0A8A8A;
}

.settings-content {
    padding: 24px;
    min-height: 280px;
}

/* Setting rows */
.setting-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 20px;
}

.setting-label {
    color: #8A9BB5;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    width: 140px;
    flex-shrink: 0;
}

.setting-control {
    flex-grow: 1;
}

/* Slot table in Save Data tab */
.slot-row {
    flex-direction: row;
    align-items: center;
    height: 48px;
    padding-left: 8px;
    padding-right: 8px;
    border-bottom-width: 1px;
    border-bottom-color: #2E4060;
}

.slot-row--even { background-color: #1A2535; }
.slot-row--odd  { background-color: #22304A; }

.slot-name  { width: 80px; color: #8A9BB5; font-size: 11px; -unity-font-style: bold; letter-spacing: 1px; }
.slot-week  { width: 80px; color: #E8EDF3; font-size: 14px; }
.slot-time  { flex-grow: 1; color: #8A9BB5; font-size: 12px; }
.slot-status-incompatible { color: #E8A020; font-size: 11px; }
.slot-status-corrupted    { color: #C0392B; font-size: 11px; }

.slot-delete-btn {
    width: 72px;
    height: 28px;
    background-color: rgba(0,0,0,0);
    border-width: 1px;
    border-color: #C0392B;
    border-radius: 0;
    color: #C0392B;
    font-size: 11px;
    -unity-text-align: middle-center;
}

.slot-delete-btn:hover    { background-color: #C0392B; color: #E8EDF3; }
.slot-delete-btn:disabled { border-color: #2E4060; color: #2E4060; }

/* ——— Pause overlay ——————————————————————————————————————— */

.pause-panel {
    width: 320px;
    align-items: stretch;
}

.pause-menu-btn {
    height: 48px;
    margin: 0;
    margin-bottom: 1px;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    border-radius: 0;
    color: #8A9BB5;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    transition-property: background-color, color;
    transition-duration: 100ms;
}

.pause-menu-btn:hover { background-color: #22304A; color: #E8EDF3; }
.pause-menu-btn--danger:hover { background-color: #C0392B; color: #E8EDF3; }